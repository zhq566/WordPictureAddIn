<Window x:Class="WordPictureAddIn.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="图片贴图"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Transparent"
        AllowsTransparency="True"
        UseLayoutRounding="True"
        KeyDown="Window_KeyDown"
        MouseDown="Window_MouseDown"
        MouseWheel="Window_MouseWheel"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        Deactivated="Window_Deactivated"
        SizeChanged="Window_SizeChanged"
        LocationChanged="Window_LocationChanged">
    <Window.Resources>
        <!-- 透明预览棋盘格画刷 -->
        <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,16,16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#CCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8"/>
                                <RectangleGeometry Rect="8,8,8,8"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <!-- 色板中的预设颜色块 -->
        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SwatchBorder"
                                CornerRadius="8"
                                BorderBrush="#D0D4DA"
                                BorderThickness="1"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwatchBorder" Property="BorderBrush" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 工具栏普通按钮 -->
        <Style x:Key="ToolActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF1F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF1F4"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EEF9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- 贴图本体：外围 10px 留给阴影，不响应鼠标点击 -->
        <Border x:Name="RootBorder"
                Margin="10"
                BorderThickness="1"
                BorderBrush="#66808080"
                Background="Transparent"
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12"
                                  ShadowDepth="0"
                                  Opacity="0.45"
                                  Color="#000000"
                                  RenderingBias="Performance"/>
            </Border.Effect>

            <Canvas x:Name="ImageCanvas"
                    ClipToBounds="True"
                    Background="Transparent"
                    Cursor="SizeAll">
                <Canvas x:Name="ContentCanvas"
                        RenderTransformOrigin="0,0"
                        MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown"
                        MouseWheel="PreviewImage_MouseWheel">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ContentScaleTransform" ScaleX="1" ScaleY="1"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                    <Rectangle x:Name="ImageBackdrop"
                               IsHitTestVisible="False"
                               Fill="#C7EDCC"/>
                    <Image x:Name="PreviewImage"
                           Stretch="Fill"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Canvas x:Name="AnnotationCanvas"
                            Panel.ZIndex="5"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            MouseLeftButtonDown="AnnotationCanvas_MouseLeftButtonDown"
                            MouseLeftButtonUp="AnnotationCanvas_MouseLeftButtonUp"
                            MouseMove="AnnotationCanvas_MouseMove"/>
                </Canvas>
            </Canvas>
        </Border>

        <!-- 悬停工具栏：放在 Popup 里，避免小图贴图放不下 -->
        <Popup x:Name="ToolbarPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=RootBorder}"
               HorizontalOffset="0"
               VerticalOffset="4"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border x:Name="ToolbarPanel"
                    Margin="6"
                    Padding="8,6"
                    CornerRadius="14"
                    Background="#FAFFFFFF"
                    BorderBrush="#E7EAF0"
                    BorderThickness="1"
                    MouseLeave="ToolbarPanel_MouseLeave">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10"
                                      ShadowDepth="0"
                                      Opacity="0.30"
                                      Color="#000000"
                                      RenderingBias="Performance"/>
                </Border.Effect>

                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="LineToolButton"
                                  Style="{StaticResource ToolToggleStyle}"
                                  Click="ToolButton_Click"
                                  Tag="Line"
                                  ToolTip="直线">
                        <Grid Width="20" Height="16">
                            <Path Stroke="#4B5563" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M1,8 L19,8"/>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="RectangleToolButton"
                                  Style="{StaticResource ToolToggleStyle}"
                                  Click="ToolButton_Click"
                                  Tag="Rectangle"
                                  ToolTip="矩形">
                        <Rectangle Width="20" Height="14" Stroke="#4B5563" StrokeThickness="2.2" RadiusX="2" RadiusY="2"/>
                    </ToggleButton>
                    <ToggleButton x:Name="EllipseToolButton"
                                  Style="{StaticResource ToolToggleStyle}"
                                  Click="ToolButton_Click"
                                  Tag="Ellipse"
                                  ToolTip="圆形">
                        <Ellipse Width="19" Height="19" Stroke="#4B5563" StrokeThickness="2.2"/>
                    </ToggleButton>
                    <ToggleButton x:Name="ArrowToolButton"
                                  Style="{StaticResource ToolToggleStyle}"
                                  Click="ToolButton_Click"
                                  Tag="Arrow"
                                  ToolTip="箭头">
                        <Grid Width="20" Height="22">
                            <Path Stroke="#4B5563" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M10,19 L10,5"/>
                            <Path Stroke="#4B5563" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,11 L10,5 L16,11"/>
                        </Grid>
                    </ToggleButton>
                    <ToggleButton x:Name="TextToolButton"
                                  Style="{StaticResource ToolToggleStyle}"
                                  Click="ToolButton_Click"
                                  Tag="Text"
                                  ToolTip="文字">
                        <TextBlock Text="T"
                                   FontFamily="Microsoft YaHei UI"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#4B5563"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </ToggleButton>

                    <Border Width="1"
                            Height="20"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="#E1E4E8"/>

                    <Button x:Name="UndoButton"
                            Style="{StaticResource ToolActionButtonStyle}"
                            Click="UndoButton_Click"
                            ToolTip="撤销">
                        <Grid Width="20" Height="18">
                            <Path Stroke="#4B5563"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M15,5 C12,3 8,3 6,5 C4,8 4,11 6,13 C8,15 12,15 14,13"
                                  Stretch="Fill"
                                  Margin="3,4,4,1"/>
                            <Path Stroke="#4B5563"
                                  StrokeThickness="2.4"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Data="M8,3 L4,5 L8,8"/>
                        </Grid>
                    </Button>

                    <Button x:Name="RestoreSizeButton"
                            Style="{StaticResource ToolActionButtonStyle}"
                            Click="RestoreSizeButton_Click"
                            ToolTip="恢复原始尺寸">
                        <Grid Width="19" Height="19">
                            <Rectangle Width="15" Height="12" Stroke="#4B5563" StrokeThickness="1.8" RadiusX="2" RadiusY="2"/>
                            <Path Stroke="#4B5563" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M13,3 L17,3 L17,7"/>
                            <Path Stroke="#4B5563" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,16 L2,16 L2,12"/>
                        </Grid>
                    </Button>

                    <Button x:Name="BackgroundColorButton"
                            Style="{StaticResource ToolActionButtonStyle}"
                            Click="BackgroundColorButton_Click"
                            ToolTip="预览底色">
                        <Grid Width="19" Height="19">
                            <Rectangle x:Name="BackgroundColorPreview"
                                       Width="16"
                                       Height="16"
                                       RadiusX="3"
                                       RadiusY="3"
                                       Fill="#C7EDCC"
                                       Stroke="#9AA0A6"
                                       StrokeThickness="1"/>
                        </Grid>
                    </Button>

                    <Button x:Name="SaveButton"
                            Style="{StaticResource ToolActionButtonStyle}"
                            Click="SaveButton_Click"
                            ToolTip="保存">
                        <Grid Width="19" Height="19">
                            <Rectangle Width="16" Height="16" Stroke="#4B5563" StrokeThickness="1.8" RadiusX="2" RadiusY="2"/>
                            <Rectangle Width="9" Height="4" Fill="#4B5563" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <Rectangle Width="7" Height="4" Stroke="#4B5563" StrokeThickness="1.4" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                        </Grid>
                    </Button>

                    <Border Width="1"
                            Height="20"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="#E1E4E8"/>

                    <Button x:Name="CloseButton"
                            Style="{StaticResource ToolActionButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="关闭（Esc）">
                        <Grid Width="16" Height="16">
                            <Path Stroke="#4B5563" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M2,2 L14,14"/>
                            <Path Stroke="#4B5563" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M14,2 L2,14"/>
                        </Grid>
                    </Button>

                    <Popup x:Name="BackgroundColorPopup"
                           Placement="Top"
                           PlacementTarget="{Binding ElementName=BackgroundColorButton}"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,0,0,8"
                                Padding="10,8"
                                CornerRadius="14"
                                Background="#FAFFFFFF"
                                BorderBrush="#E7EAF0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10"
                                                  ShadowDepth="0"
                                                  Opacity="0.30"
                                                  Color="#000000"
                                                  RenderingBias="Performance"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="预览底色"
                                           Margin="3,0,3,5"
                                           FontFamily="Microsoft YaHei UI"
                                           FontSize="12"
                                           Foreground="#6B7280"/>
                                <WrapPanel Width="180" Orientation="Horizontal">
                                    <Button Style="{StaticResource SwatchButtonStyle}"
                                            Background="#C7EDCC"
                                            Tag="#C7EDCC"
                                            ToolTip="豆沙绿"
                                            Click="BackgroundSwatch_Click"/>
                                    <Button Style="{StaticResource SwatchButtonStyle}"
                                            Background="#FFFFFF"
                                            Tag="#FFFFFF"
                                            ToolTip="白色"
                                            Click="BackgroundSwatch_Click"/>
                                    <Button Style="{StaticResource SwatchButtonStyle}"
                                            Background="#E5E5E5"
                                            Tag="#E5E5E5"
                                            ToolTip="浅灰"
                                            Click="BackgroundSwatch_Click"/>
                                    <Button Style="{StaticResource SwatchButtonStyle}"
                                            Background="#000000"
                                            Tag="#000000"
                                            ToolTip="黑色"
                                            Click="BackgroundSwatch_Click"/>
                                    <Button Style="{StaticResource SwatchButtonStyle}"
                                            Background="{StaticResource CheckerboardBrush}"
                                            Tag="Transparent"
                                            ToolTip="透明（棋盘格）"
                                            Click="BackgroundSwatch_Click"/>
                                </WrapPanel>
                                <Button Margin="3,6,3,0"
                                        Height="28"
                                        Click="CustomBackgroundColorButton_Click"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ButtonBorder"
                                                    BorderBrush="#E1E4E8"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Background="Transparent">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#EEF1F4"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#E7EEF9"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock Text="自定义…"
                                               FontFamily="Microsoft YaHei UI"
                                               FontSize="12"
                                               Foreground="#374151"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
